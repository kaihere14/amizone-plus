{
  "manifest_version": 3,
  "name": "AmizonePlus",
  "version": "1.0.0",
  "description": "View and download Amizone syllabus & session-plan files with readable names, instead of broken modals and GUID downloads.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://s.amizone.net/*",
    "https://img.amizone.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://s.amizone.net/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
